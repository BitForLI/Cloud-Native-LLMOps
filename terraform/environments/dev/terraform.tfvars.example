aws_region              = "ap-southeast-2"
project_name            = "cloud-native-llmops"
vpc_cidr                = "10.20.0.0/16"
availability_zone_count = 2
nat_gateway_mode        = "single"
job_visibility_timeout_seconds = 180
job_max_receive_count           = 5
alarm_notification_emails       = [] # e.g. ["platform@example.com"]
bedrock_model_id                = "anthropic.claude-3-haiku-20240307-v1:0"
api_image_tag                   = "bootstrap"
worker_image_tag                = "bootstrap"
api_desired_count               = 1
worker_desired_count            = 1
log_retention_days              = 30
otel_trace_sample_ratio         = 1

# Configure an ACM certificate to enable HTTPS and automatic HTTP redirect.
# alb_certificate_arn = "arn:aws:acm:ap-southeast-2:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# If the AWS account already has the GitHub provider, pass its ARN to avoid a duplicate.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Pin zones only when deterministic placement is required.
# availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]
