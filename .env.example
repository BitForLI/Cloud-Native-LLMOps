APP_ENV=local
AWS_REGION=ap-southeast-2
LLM_PROVIDER=local
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.0
# Set these from the current AWS pricing page for the selected model and region.
# BEDROCK_INPUT_COST_PER_MILLION_TOKENS=0.25
# BEDROCK_OUTPUT_COST_PER_MILLION_TOKENS=1.25
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
