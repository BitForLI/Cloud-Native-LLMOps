APP_ENV=local
API_AUTH_TOKEN=
AWS_REGION=ap-southeast-2
LLM_PROVIDER=local
JOB_BACKEND=memory
# Required when JOB_BACKEND=aws. Never put AWS access keys in this file.
# JOB_TABLE_NAME=llmops-dev-jobs
# INFERENCE_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/llmops-dev-inference
JOB_TTL_SECONDS=604800
JOB_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=20
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.0
# Set these from the current AWS pricing page for the selected model and region.
# BEDROCK_INPUT_COST_PER_MILLION_TOKENS=0.25
# BEDROCK_OUTPUT_COST_PER_MILLION_TOKENS=1.25
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
JOB_MAX_WORKERS=2
JOB_MAX_PENDING=100
JOB_MAX_STORED=1000
JOB_POLL_INTERVAL_SECONDS=0.25
